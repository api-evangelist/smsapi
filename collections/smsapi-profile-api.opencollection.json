{
  "opencollection": "1.0.0",
  "info": {
    "name": "SMSAPI REST 2FA Profile API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profile",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account profile and balance.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smsapi.com/profile"
          },
          "docs": "Returns account profile details and the current points (credit) balance."
        }
      ]
    }
  ],
  "bundled": true
}